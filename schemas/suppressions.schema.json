{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelscan.example/schemas/suppressions.schema.json",
  "title": "SentinelScan suppressions",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "type": "object",
    "required": ["fingerprint", "reason", "expiresAt"],
    "properties": {
      "fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
      "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "owner": { "type": "string", "maxLength": 200 },
      "expiresAt": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": false
  }
}
