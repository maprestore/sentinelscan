{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelscan.example/schemas/checkpoint.schema.json",
  "title": "SentinelScan checkpoint",
  "type": "object",
  "required": ["schemaVersion", "status", "target", "scope"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "enum": ["in-progress", "complete"] },
    "target": { "type": "string", "format": "uri" },
    "scope": { "$ref": "scope.schema.json" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "elapsedMs": { "type": "integer", "minimum": 0 },
    "requestCount": { "type": "integer", "minimum": 0 },
    "wellKnownIndex": { "type": "integer", "minimum": 0, "maximum": 9 },
    "queued": { "type": "array" },
    "deferred": { "type": "array" },
    "visited": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "$ref": "finding.schema.json" } }
  },
  "additionalProperties": true
}
