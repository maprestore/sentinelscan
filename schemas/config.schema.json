{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelscan.example/schemas/config.schema.json",
  "title": "SentinelScan configuration",
  "type": "object",
  "properties": {
    "maxPages": { "type": "integer", "minimum": 1, "maximum": 500 },
    "maxRedirects": { "type": "integer", "minimum": 0, "maximum": 10 },
    "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "delayMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "maxResources": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "maxRequests": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "maxElapsedMs": { "type": "integer", "minimum": 1, "maximum": 900000 },
    "checkInfrastructure": { "type": "boolean" },
    "certificateTransparency": { "type": "boolean" },
    "allowPrivateNetwork": { "type": "boolean" },
    "rendered": { "type": "boolean" },
    "confirmRendered": { "type": "boolean" },
    "emailDomain": { "type": "string" },
    "dkimSelectors": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,63}$" } },
    "authHeaders": { "type": "object", "additionalProperties": { "type": "string" } },
    "authHeaderOrigins": { "type": "array", "items": { "type": "string" } },
    "suppressions": { "$ref": "suppressions.schema.json" },
    "exitPolicy": {
      "type": "object",
      "properties": {
        "failOnSeverity": { "type": ["string", "null"], "enum": ["info", "low", "medium", "high", null] },
        "failOnBaseline": { "enum": ["never", "new", "changed", "regressed"] },
        "requireBaseline": { "type": "boolean" },
        "failOnIncomplete": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
